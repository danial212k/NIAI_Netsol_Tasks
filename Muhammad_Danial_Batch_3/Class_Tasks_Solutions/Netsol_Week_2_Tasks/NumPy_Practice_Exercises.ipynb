# Create a 1D NumPy array temperatures from the list [30, 32, 29, 35, 31]. Print its .shape, .ndim, .size, and .dtype.

temperatures = np.ndarray([30, 32, 29, 35, 31])

print(temperatures.shape)
print(temperatures.ndim)
print(temperatures.size)
print(temperatures.dtype)

# Create a 4x4 array of zeros, a 3x3 array filled with the value 9, and a 5x5 identity matrix. Print all three.
print(np.zeros((4, 4)))
print("\n")
print(np.full((3, 3), 9))
print("\n")
print(np.eye(5))

# Create the array values = np.arange(10, 60, 5). Print the first 3 elements, the last 3 elements, and every second element.
array_values = np.arange(10, 60, 5)
print(array_values[:3])
print(array_values[-3:])
print(array_values[::2])

