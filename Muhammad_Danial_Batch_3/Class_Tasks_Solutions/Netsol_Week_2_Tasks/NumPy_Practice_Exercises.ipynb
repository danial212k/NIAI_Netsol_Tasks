# You are given a raw feature column representing house sizes in square feet:

# house_sizes = np.array([850, 900, 1200, 1500, 2000, 750, 1100])
# Normalize this array so every value is scaled into the range [0, 1], using the formula (value - min) / (max - min). Do this in a single vectorized line (no loop), then print the result.

house_sizes = np.array([850, 900, 1200, 1500, 2000, 750, 1100])
house_sizes_scaled = (house_sizes - house_sizes.min()) / (house_sizes.max() - house_sizes.min())
print(house_sizes_scaled)

# You are given a small feature matrix (3 samples, 3 features each) and a fixed weight vector:

# X = np.array([
#     [2, 3, 1],
#     [5, 1, 4],
#     [1, 1, 1],
# ])
# weights = np.array([0.4, 0.4, 0.2])
# Compute the predictions for all three samples in a single line using @. Then find the index of the sample with the highest predicted value using np.argmax.

X = np.array([
    [2, 3, 1],
    [5, 1, 4],
    [1, 1, 1],
])
weights = np.array([0.4, 0.4, 0.2])

prediction = X @ weights

# You are given marks for 4 students across 3 subjects:

# student_marks = np.array([
#     [78, 85, 90],
#     [88, 92, 95],
#     [55, 62, 58],
#     [90, 87, 93],
# ])
# Using only vectorized NumPy operations (no Python loops):

# Compute each student's average mark (axis=1).
# Compute the class average for each subject (axis=0).
# Use boolean indexing to find which students have an average >= 80.
# Save the array of per-student averages to a file student_averages.npy, then load it back and print it.

student_marks = np.array([
    [78, 85, 90],
    [88, 92, 95],
    [55, 62, 58],
    [90, 87, 93],
])

student_avgs = student_marks.mean(axis=1) # row
class_avgs = student_marks.mean(axis=0) # column
top_students_marks = student_marks[student_marks >= 80]
print(top_students_marks)

# np.set_printoptions(precision=2)
print(student_avgs)
# print(class_avgs)

np.save("sample_data/student_averages.npy", student_avgs)

loaded_averages = np.load("sample_data/student_averages.npy")
print("Loaded back from disk:", loaded_averages)