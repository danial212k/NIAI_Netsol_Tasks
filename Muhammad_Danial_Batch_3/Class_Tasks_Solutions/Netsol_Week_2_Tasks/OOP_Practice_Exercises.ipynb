# Create a class Rectangle with width and height attributes, and two methods: area() (returns width * height) and perimeter() (returns 2 * (width + height)). Create an object and print both results.
class Rectangle:
    def __init__(self, width, height):
        self.width = width
        self.height = height

    def area(self):
        return self.width * self.height

    def perimeter(self):
        return 2 * (self.width + self.height)

rect1 = Rectangle(5, 3)
print(rect1.area())
print(rect1.perimeter())

# Create a class Wallet with a "protected" attribute _balance (starting value passed into __init__). Add a method withdraw(amount) that only allows the withdrawal if amount <= self._balance; otherwise it should print "Insufficient funds." and not change the balance. Add a method get_balance() to check the balance. Test both a successful and a failed withdrawal.
class Wallet:
    def __init__(self, balance):
        self._balance = balance

    def withdraw(self, amount):
        if amount <= self._balance:
            self._balance -= amount
            print(f"Withdrew {amount}. New balance: {self._balance}")
        else:
            print("Insufficient funds.")

    def get_balance(self):
        return self._balance

wallet1 = Wallet(1000)
wallet1.withdraw(300)     # succeeds
wallet1.withdraw(5000)    # fails
print(wallet1.get_balance())

# Create a parent class Vehicle with brand and speed attributes and a method describe() returning a sentence about the vehicle. Create a child class ElectricVehicle that inherits from Vehicle, adds a battery_range attribute, and overrides describe() to also mention the battery range (using super() to reuse the parent's description)
class Vehicle:
    def __init__(self, brand, speed):
        self.brand = brand
        self.speed = speed

    def describe(self):
        return f"{self.brand} can travel at {self.speed} km/h."


class ElectricVehicle(Vehicle):
    def __init__(self, brand, speed, battery_range):
        super().__init__(brand, speed)
        self.battery_range = battery_range

    def describe(self):
        base = super().describe()
        return f"{base} It has a battery range of {self.battery_range} km."


ev = ElectricVehicle("Tesla", 250, 500)
print(ev.describe())

# Create two classes, Circle (with radius) and Square (with side), each with an area() method (radius ** 2 * 3.1416 and side ** 2 respectively). Put one of each into a list and loop through it, printing each shape's area — this is polymorphism in action.
class Circle:
    def __init__(self, radius):
        self.radius = radius

    def area(self):
        return self.radius ** 2 * 3.1416


class Square:
    def __init__(self, side):
        self.side = side

    def area(self):
        return self.side ** 2


shapes = [Circle(5), Square(4)]

for shape in shapes:
    print(f"{type(shape).__name__} area: {shape.area():.2f}")

