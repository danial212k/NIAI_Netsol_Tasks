# Create a class Dataset that stores a list of numeric values (passed into __init__). Add methods:

# mean() — returns the average of the values.
# minimum() — returns the smallest value.
# maximum() — returns the largest value.
# normalize() — returns a new list where each value is scaled to the range [0, 1] using (value - minimum) / (maximum - minimum).
# Test all four methods on Dataset([10, 20, 30, 40, 50]).

class Dataset:
    def __init__(self, values):
        self.values = values

    def mean(self):
        return sum(self.values) / len(self.values)

    def minimum(self):
        return min(self.values)

    def maximum(self):
        return max(self.values)

    def normalize(self):
        low = self.minimum()
        high = self.maximum()
        return [(v - low) / (high - low) for v in self.values]


data = Dataset([10, 20, 30, 40, 50])
print("Mean:", data.mean())
print("Min:", data.minimum())
print("Max:", data.maximum())
print("Normalized:", data.normalize())

# Create a base class BaseModel with an __init__ that sets self.is_trained = False, and a method predict() that raises a ValueError if self.is_trained is False (mirroring the SimpleAverageModel example from the concepts notebook).

# Create two child classes:

# ConstantModel — its fit(training_values) stores a fixed constant (e.g. the maximum of training_values) and sets self.is_trained = True; its predict(n) returns a list of n copies of that constant.
# AverageModel — its fit(training_values) stores the average, and predict(n) returns n copies of the average.
# Both should reuse the parent's predict() guard logic somehow (hint: you can still call super().predict() first inside the child's predict(), purely to trigger the "not trained" check, before returning your own result — or re-check self.is_trained directly).

# Train both models on [5, 10, 15, 20, 25], call predict(3) on each, and print the results. Then create a third, untrained model of either type and confirm calling predict() raises the expected error.

class BaseModel:
    def __init__(self):
        self.is_trained = False

    def predict(self):
        if not self.is_trained:
            raise ValueError("Model has not been trained yet. Call fit() first.")


class ConstantModel(BaseModel):
    def __init__(self):
        super().__init__()
        self.constant = None

    def fit(self, training_values):
        self.constant = max(training_values)
        self.is_trained = True

    def predict(self, n):
        super().predict()   # reuse the parent's "not trained" guard
        return [self.constant] * n


class AverageModel(BaseModel):
    def __init__(self):
        super().__init__()
        self.average = None

    def fit(self, training_values):
        self.average = sum(training_values) / len(training_values)
        self.is_trained = True

    def predict(self, n):
        super().predict()
        return [self.average] * n


training_data = [5, 10, 15, 20, 25]

constant_model = ConstantModel()
constant_model.fit(training_data)
print(constant_model.predict(3))

average_model = AverageModel()
average_model.fit(training_data)
print(average_model.predict(3))

untrained_model = AverageModel()
try:
    untrained_model.predict(2)
except ValueError as error:
    print("Error:", error)

# You previously worked with student records as dictionaries: {"name": "Ali", "marks": [78, 85, 90]}. Rewrite this idea using a class StudentRecord with name and marks attributes, and methods average() and grade() (same grading rule as earlier notebooks: >=90 → "A", >=75 → "B", >=60 → "C", else "F"). Create a list of at least 4 StudentRecord objects, then use a list comprehension to build a list of names of students with grade "A" or "B".
class StudentRecord:
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks

    def average(self):
        return sum(self.marks) / len(self.marks)

    def grade(self):
        avg = self.average()
        if avg >= 90:
            return "A"
        elif avg >= 75:
            return "B"
        elif avg >= 60:
            return "C"
        else:
            return "F"


students = [
    StudentRecord("Ali", [78, 85, 90]),
    StudentRecord("Sara", [88, 92, 95]),
    StudentRecord("Ahmed", [55, 62, 58]),
    StudentRecord("Ayesha", [90, 87, 93]),
]

top_students = [s.name for s in students if s.grade() in ("A", "B")]
print(top_students)