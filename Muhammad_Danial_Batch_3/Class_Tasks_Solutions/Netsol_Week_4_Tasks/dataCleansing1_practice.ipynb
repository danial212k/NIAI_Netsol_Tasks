# Write a function convert_into_marla(text) that converts an area string into a single unit, Marla:

# 1 Kanal = 20 Marla
# 1 Sq. Yd. = (value * 9) / 225 Marla
# values already in Marla stay the same
# (Hint: use regex to separate the numeric value from the unit text, e.g. re.search(r"\d+\.?\d*", text) for the number.)

def convert_into_marla(text):
    number_match = re.search(r"\d+\.?\d*", text)
    unit_match = re.search(r"[a-zA-Z. ]+$", text)

    if not number_match or not unit_match:
        return None

    value = float(number_match.group())
    unit = unit_match.group().strip().lower()

    if 'kanal' in unit:
        return value * 20
    elif 'sq. yd.' in unit or 'sq yd' in unit:
        return (value * 9) / 225
    elif 'marla' in unit:
        return value
    else:
        return None

# Apply convert_into_marla to area and insert the result as a new column area_value, at position 7.
df.insert(7, 'area_value', df['area'].apply(convert_into_marla))

