# Import numpy as np, pandas as pd, re, seaborn as sns, and matplotlib.pyplot as plt.
import numpy as np
import pandas as pd
import re
import seaborn as sns
import matplotlib.pyplot as plt

# Set pandas display options so all rows and columns are shown.
pd.set_option('display.max_rows', None)
pd.set_option('display.max_columns', None)

# Load dataCleansing1_complete.csv (the output of Part 1) into a dataframe df, using index_col=0. Preview the first rows.
df = pd.read_csv('dataCleansing1_complete.csv', index_col=0)

df.head()

# Check the value counts of land_type.
df['land_type'].value_counts()

# Group by land_type and compute the mean area_value for each type.
df.groupby('land_type')['area_value'].mean()

# Check for null values in every column (isnull().sum()).
df.isnull().sum()

# Plot a bar chart of the land_type value counts.
df['land_type'].value_counts().plot(kind='bar')
plt.xlabel('Land Type')
plt.ylabel('Count')
plt.title('Land Type Value Counts')
plt.show()

# For each land_type, compute the total price_cr and the total area_value (via groupby(...).sum()), then compute price-per-marla as total_price / total_area for each type. Sort the result and plot it as a bar chart.
grouped = df.groupby('land_type')[['price_cr', 'area_value']].sum()

grouped['price_per_marla'] = grouped['price_cr'] / grouped['area_value']

grouped = grouped.sort_values('price_per_marla')

grouped['price_per_marla'].plot(kind='bar')
plt.xlabel('Land Type')
plt.ylabel('Price per Marla (Crore)')
plt.title('Price per Marla by Land Type')
plt.show()

# Display that same price-per-marla series sorted in descending order.
grouped['price_per_marla'].sort_values(ascending=False)

# Define four lists grouping the land types into broader categories:

# residential = ["House", "Flat", "Residential Plot"]
# commercial = ["Building", "Shop", "Office", "Commercial Plot"]
# agricultural = ["Plot File", "Farm House", "Agricultural Land"]
# industrial = ["Factory", "Industrial Land"]

residential = ["House", "Flat", "Residential Plot"]

commercial = ["Building", "Shop", "Office", "Commercial Plot"]

agricultural = ["Plot File", "Farm House", "Agricultural Land"]

industrial = ["Factory", "Industrial Land"]

# Using the price-per-marla series from the earlier task, show only the values for residential and commercial land types (hint: .isin([...])). Compare them.
grouped['price_per_marla'].loc[
    grouped.index.isin(residential + commercial)
]

# Show only the price-per-marla values for agricultural land types.
grouped['price_per_marla'].loc[
    grouped.index.isin(agricultural)
]

# Show only the price-per-marla values for industrial land types.
grouped['price_per_marla'].loc[
    grouped.index.isin(industrial)
]

# Create df1 by dropping the columns location, price, area, added_days, and purpose from df (we'll use the already-cleaned versions of these instead).
df1 = df.drop(columns=['location', 'price', 'area', 'added_days', 'purpose'])

# Rename the locat column in df1 to location.
df1 = df1.rename(columns={'locat': 'location'})

# Split df1 into four separate dataframes, using the category lists you defined earlier and filtering on land_type: residential_df, commercial_df, agricultural_df, industrial_df.
residential_df = df1[df1['land_type'].isin(residential)]

commercial_df = df1[df1['land_type'].isin(commercial)]

agricultural_df = df1[df1['land_type'].isin(agricultural)]

industrial_df = df1[df1['land_type'].isin(industrial)]

# Plot a bar chart (figsize (5,4)) of the land_type value counts within residential_df.
plt.figure(figsize=(5, 4))
residential_df['land_type'].value_counts().plot(kind='bar')
plt.xlabel('Land Type')
plt.ylabel('Count')
plt.title('Residential Land Types')
plt.show()

# Compute the percentage share of each land_type within residential_df (count of each type divided by total rows, ×100).
residential_share = residential_df['land_type'].value_counts() / len(residential_df) * 100
residential_share

# Based on the percentages above, write 2–3 bullet points on which land types dominate the residential segment, and roughly by how much.
for land_type, percentage in residential_share.items():
    print(f"- {land_type} dominates the residential segment with approximately {percentage:.1f}% of listings.")

# Check the location value counts within residential_df.
residential_df['location'].value_counts()

# Check the normalized (percentage) value counts of location, top 10 only.
residential_df['location'].value_counts(normalize=True).head(10) * 100

# location is a high-cardinality column. Find how many distinct locations occur fewer than 10 times.
location_counts = residential_df['location'].value_counts()
(location_counts < 10).sum()

# A common rule of thumb: categories making up less than roughly 0.01% of rows can be grouped into "Others". Find location categories with fewer than 40 occurrences, and replace them with "Others" in residential_df["location"].
location_counts = residential_df['location'].value_counts()

residential_df['location'] = residential_df['location'].where(
    residential_df['location'].map(location_counts) >= 40,
    'Others'
)

# Create a mean target encoding for location: group residential_df by location, take the mean of price_cr, and map those means back onto a new column location_encoded.
location_mean = residential_df.groupby('location')['price_cr'].mean()

residential_df['location_encoded'] = residential_df['location'].map(location_mean)

# Preview a few sample rows to confirm the new column looks right.
residential_df[['location', 'price_cr', 'location_encoded']].sample(5)

# Get summary statistics (.describe()) for price_cr in residential_df. Compare the mean to the median — what does the gap suggest?
residential_df['price_cr'].describe()

# Plot a histogram of price_cr (100 bins, with KDE).
sns.histplot(residential_df['price_cr'], bins=100, kde=True)

plt.xlabel('Price (Crore)')
plt.ylabel('Count')
plt.title('Distribution of Residential Property Prices')
plt.show()

# Plot the same histogram again, but with a log-scaled x-axis (log_scale=True).
sns.histplot(
    residential_df['price_cr'],
    bins=100,
    kde=True,
    log_scale=True
)

plt.xlabel('Price (Crore, log scale)')
plt.ylabel('Count')
plt.title('Distribution of Residential Property Prices')
plt.show()

# Is price_cr left-skewed or right-skewed? What does that tell you about typical vs. extreme listing prices?

# price_cr is right-skewed (positively skewed).

# Most residential listings are concentrated at lower-to-moderate prices.
# A smaller number of very expensive listings create a long tail to the right.
# Therefore, the mean is pulled upward by extreme prices, while the median better represents a typical listing price.

# Plot a boxplot of price_cr to visualize outliers.
sns.boxplot(x=residential_df['price_cr'])

plt.xlabel('Price (Crore)')
plt.title('Boxplot of Residential Property Prices')
plt.show()

# Filter rows where price_cr > 50 into a new dataframe df_50, then compute a new column price_per_marla = price_cr / area_value for that subset.
df_50 = residential_df[residential_df['price_cr'] > 50].copy()

df_50['price_per_marla'] = df_50['price_cr'] / df_50['area_value']

# Compute the skewness of price_cr (.skew()).
residential_df['price_cr'].skew()

# Compute the kurtosis of price_cr (.kurt()).
residential_df['price_cr'].kurt()

# Plot a boxplot of price_cr grouped by land_type (x = land_type, y = price_cr), showing outliers, with x-axis labels rotated 90°, a log-scaled y-axis, and a title + axis labels.
plt.figure(figsize=(10, 6))

sns.boxplot(
    data=residential_df,
    x='land_type',
    y='price_cr',
    showfliers=True
)

plt.xticks(rotation=90)
plt.yscale('log')
plt.xlabel('Land Type')
plt.ylabel('Price (Crore, log scale)')
plt.title('Price Distribution by Land Type')

plt.show()

# Compute the standard deviation of price_cr, grouped by land_type.
df.groupby('land_type')['price_cr'].std()

# Based on the spread (std) per land type from the previous task, which land types are the most scattered/variable in price? What might that imply for modeling (e.g. would separate models, or a different target like price-per-marla, make sense for those types)?

# Land types with the highest standard deviation in price_cr have the most scattered prices and therefore greater price variability within that category.
# High variability can make a single model harder to fit accurately because the same land_type may contain properties with very different prices.
# For highly variable land types, separate models could make sense if there are enough observations in each type.
# Alternatively, predicting price per marla (price_cr / area_value) may be more useful because it accounts for differences in property size and can reduce some of the variation caused by area.


# Create a new column log_price = np.log1p(price_cr).
residential_df['log_price'] = np.log1p(residential_df['price_cr'])

# Plot a boxplot of log_price. Compare it to the boxplot of raw price_cr from before — did the log transform help reduce the spread of outliers?
sns.boxplot(x=residential_df['log_price'])

plt.xlabel('Log Price')
plt.title('Boxplot of Log-Transformed Residential Property Prices')
plt.show()

# Compute the standard deviation of log_price, grouped by land_type, and compare it to the std of raw price_cr per land type from before.
log_std = residential_df.groupby('land_type')['log_price'].std()
raw_std = residential_df.groupby('land_type')['price_cr'].std()

comparison = pd.DataFrame({
    'raw_price_std': raw_std,
    'log_price_std': log_std
})

comparison

# Plot a histogram (with KDE) of log_price.
sns.histplot(residential_df['log_price'], bins=100, kde=True)

plt.xlabel('Log Price')
plt.ylabel('Count')
plt.title('Distribution of Log-Transformed Residential Property Prices')
plt.show()

# Preview a random sample of 5 rows.
residential_df.sample(5)

# Filter residential_df down to rows where land_type == "Residential Plot" only, and store the result in a new variable (e.g. residential_plot_df).
residential_plot_df = residential_df[residential_df['land_type'] == 'Residential Plot'].copy()

# Compute price_per_marla = price_cr / area_value (rounded to 2 decimals) for this subset.
residential_plot_df['price_per_marla'] = (
    residential_plot_df['price_cr'] / residential_plot_df['area_value']
).round(2)

# Preview a random sample of 5 rows.
residential_plot_df.sample(5)

# Plot a histogram (50 bins, with KDE) of price_per_marla.
sns.histplot(residential_plot_df['price_per_marla'], bins=50, kde=True)

plt.xlabel('Price per Marla (Crore)')
plt.ylabel('Count')
plt.title('Distribution of Price per Marla for Residential Plots')
plt.show()

# Plot a boxplot of price_per_marla.
sns.boxplot(x=residential_plot_df['price_per_marla'])

plt.xlabel('Price per Marla (Crore)')
plt.title('Boxplot of Price per Marla for Residential Plots')
plt.show()

# Investigate rows where price_per_marla >= 1 — these look like possible outliers or data errors. Inspect them.
outliers = residential_plot_df[
    residential_plot_df['price_per_marla'] >= 1
]

outliers

# If any rows you found above have null values, drop them.
outliers = outliers.dropna()
outliers

# Compute the standard deviation of price_per_marla after this cleanup.
outliers['price_per_marla'].std()

# Drop the columns that are no longer needed for modeling: land_type, location_encoded, log_price, baths, and bed.
residential_plot_df = residential_plot_df.drop(
    columns=['land_type', 'location_encoded', 'log_price', 'baths', 'bed']
)

