# Build a ColumnTransformer named preprocessor with:

# a numeric branch: SimpleImputer(strategy='median') -> StandardScaler()
# a categorical branch: SimpleImputer(strategy='most_frequent') -> OneHotEncoder(handle_unknown='ignore')
# Use Pipeline for each branch (two mini-pipelines inside the ColumnTransformer — this is a very common real-world pattern).

# TODO: numeric_transformer = Pipeline(steps=[...])
# TODO: categorical_transformer = Pipeline(steps=[...])
# TODO: preprocessor = ColumnTransformer(transformers=[...])

from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer

numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])

preprocessor = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features)
    ]
)

# fit_transform your preprocessor on X_train. Print the shape before and after transformation, and explain in one comment why the number of columns changed.

# TODO: X_train_transformed = preprocessor.fit_transform(X_train)
# TODO: print X_train.shape and X_train_transformed.shape
# TODO: one-line comment explaining the column count change

X_train_transformed = preprocessor.fit_transform(X_train)

print("Before transformation:", X_train.shape)
print("After transformation:", X_train_transformed.shape)

# The number of columns changes because categorical features are expanded into multiple one-hot encoded columns.

# Self Check

try:
    assert X_train_transformed.shape[0] == X_train.shape[0]
    assert X_train_transformed.shape[1] > X_train.shape[1]
    print("Self-check passed.")
except NameError:
    print("preprocessor / X_train_transformed not defined yet — complete Task 2.2-2.3 first.")
except AssertionError:
    print("Shape looks wrong — the transformed matrix should have MORE columns than the raw one (because of One-Hot Encoding).")

    # Rebuild the same ColumnTransformer but this time deliberately leave ONE categorical column out of categorical_features when you define the transformer list. Run it once with remainder='drop' and once with remainder='passthrough'. Print the resulting shapes for both and explain the difference in one comment.

# TODO: rebuild preprocessor twice, once with remainder='drop', once with remainder='passthrough'
# TODO: print shapes for both
# TODO: one-line comment explaining the difference

# Leave one categorical column out of the transformer list
categorical_features_partial = categorical_features[:-1]

numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])

# remainder='drop'
preprocessor_drop = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features_partial)
    ],
    remainder='drop'
)

X_train_drop = preprocessor_drop.fit_transform(X_train)

# remainder='passthrough'
preprocessor_passthrough = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features_partial)
    ],
    remainder='passthrough'
)

X_train_passthrough = preprocessor_passthrough.fit_transform(X_train)

print("remainder='drop':", X_train_drop.shape)
print("remainder='passthrough':", X_train_passthrough.shape)

# 'drop' removes the omitted column, while 'passthrough' keeps it unchanged in the output.

# Combine your preprocessor (from Task 2.2, using remainder='drop' version) with a LogisticRegression(max_iter=1000, random_state=42) into a Pipeline named log_reg_pipeline.

